{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with Nova ID for searching and connecting.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email"
        },
        "photoURL": {
          "type": "string",
          "description": "User's photo URL"
        },
        "novaId": {
          "type": "string",
          "description": "6-digit unique Nova ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        }
      },
      "required": ["uid", "novaId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    }
  }
}
